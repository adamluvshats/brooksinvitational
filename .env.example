# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# For Prisma, a pooled URL works for queries; set DIRECT_URL for migrations if your host requires it.
DATABASE_URL="postgresql://user:password@host:5432/brooks?sslmode=require"
# Optional direct (non-pooled) connection used by `prisma migrate`. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@host:5432/brooks?sslmode=require"

# Secret used to sign auth JWTs. Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app, used to build password-reset links in emails.
# In production set this to your deployed URL (e.g. https://brooks.example.com).
APP_URL="http://localhost:3000"

# Password-reset email via Mailgun SMTP (or any SMTP server).
# Find these under Mailgun → Sending → Domain settings → SMTP credentials.
# If SMTP_USER/SMTP_PASS are unset, reset emails are skipped (and in dev the
# reset token is returned by the API so you can still test the flow).
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@mg.yourdomain.com"
SMTP_PASS="your-mailgun-smtp-password"
MAIL_FROM="Brooks Invitational <no-reply@yourdomain.com>"
