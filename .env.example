# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# For Prisma, a pooled URL works for queries; set DIRECT_URL for migrations if your host requires it.
DATABASE_URL="postgresql://user:password@host:5432/brooks?sslmode=require"
# Optional direct (non-pooled) connection used by `prisma migrate`. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@host:5432/brooks?sslmode=require"

# Secret used to sign auth JWTs. Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app, used to build links in emails (welcome + reset).
# In production set this to your deployed URL (e.g. https://brooksinvitational.com).
APP_URL="http://localhost:3000"

# Transactional email via Resend (https://resend.com).
# RESEND_API_KEY — create at Resend → API Keys (starts with "re_").
# MAIL_FROM      — a From address on a domain you've verified in Resend.
# If RESEND_API_KEY is unset, emails are skipped (and in dev the password-reset
# token is returned by the API so you can still test the flow).
RESEND_API_KEY="re_your_resend_api_key"
MAIL_FROM="Brooks Invitational <noreply@brooksinvitational.com>"
